type Employee {
    id: ID!
    name: String
    department: Department
    salary: Float
}

type Department {
    id: ID!
    name: String!
    employees: [Employee!]!
}

type Query {
    employees: [Employee!]!
    employeeById(id: ID!): Employee
    departments: [Department!]!
    employeesByDepartment(departmentId: ID!): [Employee!]!
}

type Mutation {
    addDepartment(name: String!): Department!

    addEmployee(
        name: String!
        departmentId: ID!
        salary: Float!
    ): Employee!

    updateEmployee(
        id: ID!
        name: String!
        departmentId: ID!
        salary: Float!
    ): Employee!

    deleteEmployee(id: ID!): Boolean!
}